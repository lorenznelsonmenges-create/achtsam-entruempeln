# SMTP Zugangsdaten für das Kontaktformular (Hetzner konsoleH)
SMTP_SERVER=mail.your-server.de
SMTP_PORT=587
SMTP_USER=info@wendepunkt-ruf.de
SMTP_PASS=hier_dein_passwort_eintragen

# Empfängeradresse für Anfragen
MAIL_TO=info@wendepunkt-ruf.de

# Lokaler Port für den Dienst (wird von Nginx angesprochen)
PORT=8088
